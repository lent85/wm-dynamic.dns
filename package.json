{
  "name": "wm-dynamic-dns",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted DDNS gateway: routes IP updates from clients (DuckDNS/dyndns2 compatible) to multiple DNS providers (Technitium, DuckDNS, ...).",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "dev": "pnpm --filter @wm-ddns/shared build && pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @wm-ddns/shared build && pnpm --filter @wm-ddns/api dev",
    "dev:web": "pnpm --filter @wm-ddns/shared build && pnpm --filter @wm-ddns/web dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rimraf dist .turbo node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
