# =================================================================
# wm-dynamic-dns environment template
# Copy to .env and fill in real values before running.
# =================================================================

# HTTP server
PORT=8991
HOST=0.0.0.0

# Trust X-Forwarded-For from upstream proxy (Caddy/Nginx/Cloudflare)
# Set to "true" when running behind a reverse proxy that you control.
TRUST_PROXY=false

# SQLite database file (will be created on first boot)
DATABASE_URL=file:./data/app.db

# JWT secret for admin UI sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-please-48-bytes-hex

# Symmetric key used to encrypt provider credentials at rest (AES-256-GCM).
# MUST be exactly 64 hex chars (= 32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=change-me-32-bytes-hex-64-chars-long-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Initial admin seed (used only on first boot when users table is empty).
# After the first login you can change the password from the UI.
ADMIN_USER=admin
ADMIN_PASS=change-me-strong-password

# Logging
LOG_LEVEL=info

# CORS origin for the SPA (leave empty to allow same-origin only)
CORS_ORIGIN=

# Public-IP detection providers used by the self-detect job (comma separated)
PUBLIC_IP_PROVIDERS=https://api.ipify.org,https://ifconfig.co/ip,https://icanhazip.com

# Self-detect job interval in seconds (set 0 to disable)
SELF_DETECT_INTERVAL_SEC=300
