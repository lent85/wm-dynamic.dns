# =================================================================
# wm-dynamic-dns environment template
# Copy to .env and fill in real values before running.
# Your real config lives in .env only — changing .env.example does not update .env.
# =================================================================

# HTTP server (docker compose maps host:container using this same PORT)
PORT=8991
HOST=0.0.0.0

# Trust X-Forwarded-For from upstream proxy (Caddy/Nginx/Cloudflare)
# Set to "true" when running behind a reverse proxy that you control.
TRUST_PROXY=false

# SQLite database file (will be created on first boot).
# Local dev: relative path ok. Docker Compose overrides this to file:/data/app.db.
DATABASE_URL=file:./data/app.db

# Optional: path to runtime-config.json (JWT, encryption key, LOG_LEVEL, CORS overrides).
# If unset, defaults to runtime-config.json next to the SQLite file (e.g. data/runtime-config.json).
# RUNTIME_CONFIG_PATH=

# JWT secret for admin UI sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-please-48-bytes-hex

# Symmetric key used to encrypt provider credentials at rest (AES-256-GCM).
# MUST be exactly 64 hex chars (= 32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Dev-only placeholder (all 0xa); replace before any real data.
APP_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Initial admin seed (used only on first boot when users table is empty).
# After the first login you can change the password from the UI.
#
# Local dev default (copy .env from this file): sign in as admin / dev-local-1234
# Replace ADMIN_PASS before any non-local deployment.
ADMIN_USER=admin
ADMIN_PASS=dev-local-1234

# Logging
LOG_LEVEL=info

# CORS origin for the SPA (leave empty to allow same-origin only)
CORS_ORIGIN=

# Public-IP detection providers used by the self-detect job (comma separated)
PUBLIC_IP_PROVIDERS=https://api.ipify.org,https://ifconfig.co/ip,https://icanhazip.com

# Self-detect job interval in seconds (set 0 to disable)
SELF_DETECT_INTERVAL_SEC=300

# Default force-refresh interval for new hostnames (seconds; min 60). 3600 = 60 minutes.
DEFAULT_FORCE_INTERVAL_SEC=3600
